    "url": "git+https://github.com/Abhijeet-Kumar-Prajapati/ABHIJEET-KUMAR-PRAJAPATI.git"
  },
  "keywords": [
    "portfolio",
    "static-site",
    "no-dependencies",
    "vanilla-js"
  ],
  "scripts": {
    "start": "node serve.js",
    "dev": "node serve.js --open",
    "docs": "node automation/build-docs.js",
